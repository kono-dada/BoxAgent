# 北京地域的 DashScope Key；不要将真实密钥提交到仓库。
DASHSCOPE_API_KEY=请在本地填写

# 完整产品体验要求 AOQ SDK 与百炼 Workspace；auto 仅保留 WebSocket 诊断降级。
BOXAGENT_QWEN_TRANSPORT=auto
BOXAGENT_DASHSCOPE_WORKSPACE_ID=请在百炼 Workspace 中查看
BOXAGENT_DASHSCOPE_REGION=cn-beijing
# BOXAGENT_AOQ_SDK_DIR=/绝对路径/aoq-sdk/1.3.0/frameworks
# BOXAGENT_AOQ_WORK_DIR=/绝对路径/BoxAgent-data/runtimes/aoq

# 桌面任务模型走 Codex App Server，只支持 OpenAI Responses 协议（wire_api="responses"）。
# 只提供 chat/completions 的端点（LiteLLM、多数学校/自建网关）接不进来，改 base_url 无效。
BOXAGENT_TASK_PROVIDER=deepseek
# 模型 slug 必须在 assets/model-catalogs/deepseek.json 里（内置 deepseek-flash / deepseek-v4-pro）。
BOXAGENT_DEEPSEEK_MODEL=deepseek-flash
# Responses 端点；换第三方供应商前先确认支持 Responses 协议，并把模型 slug 加进目录。
BOXAGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=请在本地填写
# provider=codex（OpenAI）时用 BOXAGENT_TASK_MODEL 指定模型，同样只支持 Responses。

# 决策模型（System One 协议）：Jev-Mem 记忆准入/检索与回合前意图识别共用。
# auto：配置了 DashScope Key 与工作空间时用阿里云百炼 decision-model-preview，否则用 TypeSafe.ai。
# TypeSafe 公网 API 对部分地区返回 HTTP 451。
# BOXAGENT_DECISION_PROVIDER=auto
# BOXAGENT_DECISION_MODEL=decision-model-preview
# TYPESAFE_API_KEY=仅 provider=typesafe 时需要
BOXAGENT_JEV_MEM_BACKEND=jev
# JEV 意图参考默认开启，额外准备最多等待 400 ms，超时则跳过。
# 如需关闭设为 0；不影响 JEV 记忆读写。
# BOXAGENT_INTENT_REFERENCE=0
# BOXAGENT_JEV_MEM_PYTHON=/绝对路径/.runtime/jev-mem-venv/bin/python
# BOXAGENT_JEV_MEM_CACHE=/绝对路径/memory/jev-mem

# 可选：自定义桌宠人格。未配置时优先读取 .runtime/pet/SOUL.md，再使用内置默认人格。
# BOXAGENT_SOUL_FILE=/绝对路径/SOUL.md

# 可选：源码 checkout 默认监视后端代码并只重启 Engine。
# BOXAGENT_ENGINE_WATCH=0
# Product Session 恢复到新 Runtime 时的最近历史字符预算（可选）
BOXAGENT_QWEN_HISTORY_CHARS=24000
BOXAGENT_CODEX_HISTORY_CHARS=24000
BOXAGENT_QWEN_CHECKPOINT_TRIGGER_CHARS=18000
BOXAGENT_CHECKPOINT_SOURCE_CHARS=32000
