# AppKit APIs used by the desktop launcher and window observers.
from collections.abc import Callable, Mapping, Sequence
from typing import Self

from Foundation import NSURL, NSDate, NSError, NSObject

class NSRunningApplication(NSObject):
    @classmethod
    def runningApplicationsWithBundleIdentifier_(cls, bundle_id: str, /) -> Sequence[Self]: ...
    @classmethod
    def runningApplicationWithProcessIdentifier_(cls, pid: int, /) -> Self | None: ...
    def processIdentifier(self) -> int: ...
    def localizedName(self) -> str | None: ...
    def bundleIdentifier(self) -> str | None: ...
    def bundleURL(self) -> NSURL | None: ...
    def launchDate(self) -> NSDate | None: ...
    def isHidden(self) -> bool: ...
    def isTerminated(self) -> bool: ...
    def terminate(self) -> bool: ...
    def forceTerminate(self) -> bool: ...

class NSWorkspaceOpenConfiguration(NSObject):
    @classmethod
    def configuration(cls) -> Self: ...
    def setArguments_(self, arguments: Sequence[str], /) -> None: ...
    def setEnvironment_(self, environment: Mapping[str, str], /) -> None: ...
    def setCreatesNewApplicationInstance_(self, value: bool, /) -> None: ...

class NSWorkspace(NSObject):
    @classmethod
    def sharedWorkspace(cls) -> Self: ...
    def frontmostApplication(self) -> NSRunningApplication | None: ...
    def runningApplications(self) -> Sequence[NSRunningApplication]: ...
    def openApplicationAtURL_configuration_completionHandler_(
        self,
        url: NSURL,
        configuration: NSWorkspaceOpenConfiguration,
        completion_handler: Callable[[NSRunningApplication | None, NSError | None], None] | None,
        /,
    ) -> None: ...
