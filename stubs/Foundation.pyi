# Foundation APIs used by the native adapters.
from typing import Self

class NSObject:
    @classmethod
    def alloc(cls) -> Self: ...
    def init(self) -> Self: ...

class NSBundle(NSObject):
    @classmethod
    def bundleWithPath_(cls, path: str, /) -> Self | None: ...
    def load(self) -> bool: ...

class NSData(NSObject):
    @classmethod
    def dataWithBytes_length_(cls, data: bytes, length: int, /) -> Self: ...

class NSDate(NSObject):
    @classmethod
    def dateWithTimeIntervalSinceNow_(cls, seconds: float, /) -> Self: ...
    def timeIntervalSince1970(self) -> float: ...

class NSDictionary(NSObject):
    @classmethod
    def dictionary(cls) -> Self: ...

class NSError(NSObject): ...

class NSRunLoop(NSObject):
    @classmethod
    def currentRunLoop(cls) -> Self: ...
    def runUntilDate_(self, date: NSDate, /) -> None: ...

class NSURL(NSObject):
    @classmethod
    def fileURLWithPath_(cls, path: str, /) -> Self: ...
    def isFileURL(self) -> bool: ...
    def path(self) -> str | None: ...
